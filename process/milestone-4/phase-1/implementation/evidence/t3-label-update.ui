component LabelUpdate inherits Window {
    title: "Label update"
    backdrop: mica
    theme: system

    state count: i32 = 9

    VStack {
        spacing: 12px
        padding: 24px

        Text {
            text: "Click the counting button; its own label is rebound."
            font: body
        }
        Button {
            text: "Counted \{root.count} times"
            style: accent
            clicked => { root.count += 1; }
        }
        Button {
            text: "Static reference label"
        }
        ToggleButton {
            text: "Static toggle label"
        }

        Grid {
            columns: 1*
            rows: 44

            Cell {
                row: 0 column: 0
                h-align: stretch
                v-align: stretch
                Button {
                    text: "Stretched by its cell"
                }
            }
        }
    }
}
