component Gallery inherits Window {
    title: "Gallery"
    backdrop: mica
    theme: system

    state scroll_y: i32 = 0
    state is_lightbox_open: bool = false
    state tab_all_selected: bool = true
    state tab_albums_selected: bool = false
    state tab_favorites_selected: bool = false
    state labels: string[] = [
        "IMG 001", "IMG 002", "IMG 003", "IMG 004", "IMG 005", "IMG 006",
        "IMG 007", "IMG 008", "IMG 009", "IMG 010", "IMG 011", "IMG 012",
        "IMG 013", "IMG 014", "IMG 015", "IMG 016", "IMG 017", "IMG 018"
    ]

    ZStack {
        Grid {
            slot.h-align: stretch
            slot.v-align: stretch
            columns: 1* 1*
            rows: 56 1* 28

            Cell {
                row: 0 column: 0
                h-align: start
                v-align: center
                HStack {
                    spacing: 8px
                    padding: 8px

                    ToggleButton {
                        text: "All"
                        checked: tab_all_selected
                        clicked => {
                            root.tab_all_selected = true;
                            root.tab_albums_selected = false;
                            root.tab_favorites_selected = false;
                        }
                    }
                    ToggleButton {
                        text: "Albums"
                        checked: tab_albums_selected
                        clicked => {
                            root.tab_all_selected = false;
                            root.tab_albums_selected = true;
                            root.tab_favorites_selected = false;
                        }
                    }
                    ToggleButton {
                        text: "Favorites"
                        checked: tab_favorites_selected
                        clicked => {
                            root.tab_all_selected = false;
                            root.tab_albums_selected = false;
                            root.tab_favorites_selected = true;
                        }
                    }
                }
            }

            Cell {
                row: 0 column: 1
                h-align: end
                v-align: center
                HStack {
                    spacing: 8px
                    padding: 8px

                    Button {
                        text: "Scroll down"
                        clicked => { root.scroll_y += 100; }
                    }
                    Button {
                        text: "Scroll up"
                        clicked => { root.scroll_y -= 100; }
                    }
                    Button {
                        text: "Open lightbox"
                        style: accent
                        clicked => { root.is_lightbox_open = true; }
                    }
                }
            }

            Cell {
                row: 1 column: 0 column-span: 2
                h-align: stretch
                v-align: stretch
                Box {
                    fill: #2f343b
                    ScrollView {
                        offset-y: scroll_y

                        VStack {
                            padding: 12px

                            WrapPanel {
                                item-cross-size: 88
                                item-spacing: 12
                                line-spacing: 12

                                for label, index in labels {
                                    Box {
                                        aspect: 1:1
                                        fill: #4f6272
                                        Text { text: "\{label} #\{index}" }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Cell {
                row: 2 column: 0 column-span: 2
                h-align: start
                HStack {
                    padding: 4px
                    Text { text: "18 placeholders - Image and hit-testing are M4" }
                }
            }
        }

        if is_lightbox_open {
            ZStack {
                slot.h-align: stretch
                slot.v-align: stretch

                Box {
                    slot.h-align: stretch
                    slot.v-align: stretch
                    fill: #101820cc
                }

                Grid {
                    slot.h-align: stretch
                    slot.v-align: stretch
                    columns: 1* 56 400 56 1*
                    rows: 1* 44 300 64 1*

                    Cell {
                        row: 2 column: 2
                        Box {
                            aspect: 4:3
                            fill: #5b7080
                            Text { text: "[photo]" }
                        }
                    }

                    Cell {
                        row: 3 column: 2
                        VStack {
                            spacing: 4px
                            Text { text: "IMG 001  2026-04-12" }
                            Text { text: "Box 4:3 placeholder; Image widget lands in M4" }
                        }
                    }

                    Button {
                        slot.row: 2
                        slot.column: 1
                        slot.row-span: 2
                        slot.h-align: center
                        slot.v-align: center
                        text: "<"
                    }

                    Button {
                        slot.row: 2
                        slot.column: 3
                        slot.row-span: 2
                        slot.h-align: center
                        slot.v-align: center
                        text: ">"
                    }

                    Button {
                        slot.row: 1
                        slot.column: 3
                        slot.h-align: center
                        slot.v-align: center
                        text: "x"
                        clicked => { root.is_lightbox_open = false; }
                    }
                }
            }
        }
    }
}
