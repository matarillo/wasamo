component Gallery inherits Window {
    title: "Gallery"
    backdrop: mica
    theme: system

    WrapPanel {
        item-cross-size: 88
        item-spacing: 12
        line-spacing: 12

        Box {
            aspect: 1:1
            fill: #336699cc
            Text { text: "Photo 1" }
