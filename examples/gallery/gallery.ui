        }
        Box {
            aspect: 1:1
            fill: #339966cc
            Text { text: "Photo 5" }
        }
        Box {
            aspect: 1:1
            fill: #996699cc
            Text { text: "Photo 6" }
        }
        Box {
            aspect: 1:1
            fill: #cc9933cc
            Text { text: "Photo 7" }
        }
        Box {
            aspect: 1:1
            fill: #3399cccc
            Text { text: "Photo 8" }
        }
        Box {
            aspect: 1:1
            fill: #cc6699cc
