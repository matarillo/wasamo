component Counter inherits Window {
    title: "Counter"
    backdrop: mica
    theme: system

    state count: i32 = 0

    VStack {
        spacing: 12px
        padding: 24px

        Text {
            text: "Count: \{root.count}"
            font: title
        }
        Button {
            text: "Increment"
            style: accent
            clicked => { root.count += 1; }
        }
    }
}
